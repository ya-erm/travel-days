{
  "name": "travel-days",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "unit": "jest",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:codegen": "npx playwright codegen http://localhost:5173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "tsc --noemit && prettier --check . && eslint .",
    "tsc": "tsc --noemit",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "generate:icons": "node ./pack-icons.js && prettier --write ./src/lib/icons.ts",
    "generate:prisma": "npx prisma generate",
    "generate": "npm run generate:icons && npm run generate:prisma"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@iconify/svelte": "^4.2.0",
    "@iconify/utils": "^2.2.1",
    "@playwright/test": "^1.50.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.16.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vite-pwa/sveltekit": "^0.6.7",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prisma": "^6.3.0",
    "svelte": "^4.2.19",
    "svelte-chartjs": "^3.1.5",
    "svelte-check": "^4.1.4",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.3",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@vercel/analytics": "^1.4.1",
    "@vvo/tzdb": "^6.159.0",
    "bcrypt": "^5.1.1",
    "dayjs": "^1.11.13",
    "idb": "^8.0.2",
    "svelte-dnd-action": "^0.9.56",
    "uuid": "^11.0.5"
  },
  "type": "module"
}
